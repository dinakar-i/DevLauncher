<Window x:Class="DevLauncher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DevLauncher.ViewModels"
        xmlns:conv="clr-namespace:DevLauncher.Converters"
        xmlns:models="clr-namespace:DevLauncher.Models"
        xmlns:local="clr-namespace:DevLauncher.Views"
        Title="DevLauncher"
        Height="900" Width="1340"
        MinHeight="720" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="False">

    <WindowChrome.WindowChrome>
        <WindowChrome ResizeBorderThickness="6"
                      CaptionHeight="44"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:BoolToVisibilityConverter   x:Key="BoolVis"/>
        <conv:IntToVisibilityConverter    x:Key="IntVis"/>
        <conv:TerminalTypeToColorConverter x:Key="TermColor"/>
        <conv:CategoryToBadgeColorConverter x:Key="CatColor"/>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            Background="{StaticResource BgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>   <!-- Title bar -->
                <RowDefinition Height="*"/>    <!-- Content -->
                <RowDefinition Height="24"/>   <!-- Status bar -->
            </Grid.RowDefinitions>

            <!-- ══════════════ TITLE BAR ══════════════ -->
            <Border Grid.Row="0"
                    Background="{StaticResource Surface2Brush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo (non-interactive, lets drag pass through) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                                WindowChrome.IsHitTestVisibleInChrome="False">
                        <Border Width="26" Height="26" CornerRadius="7" Margin="0,0,8,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#7C3AED" Offset="0"/>
                                    <GradientStop Color="#00E5FF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="⚡" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <TextBlock FontFamily="Segoe UI" FontWeight="ExtraBold" FontSize="14" VerticalAlignment="Center">
                            <Run Text="Dev" Foreground="{StaticResource TextBrush}"/>
                            <Run Text="Launcher" Foreground="{StaticResource AccentBrush}"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Center info (transparent to drag) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                WindowChrome.IsHitTestVisibleInChrome="False" IsHitTestVisible="False">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource Accent3Brush}" Margin="0,0,6,0">
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="1" To="0.3" Duration="0:0:1" AutoReverse="True"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <TextBlock Text="{Binding CurrentTime}"
                                   FontFamily="Consolas" FontSize="11"
                                   Foreground="{StaticResource Muted2Brush}" VerticalAlignment="Center"/>
                        <TextBlock Text="  |  " Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusText}"
                                   FontFamily="Consolas" FontSize="11"
                                   Foreground="{StaticResource Muted2Brush}" VerticalAlignment="Center"
                                   MaxWidth="400" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Window controls (standard Windows-style) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- Minimize -->
                        <Border Width="46" Height="44" Cursor="Hand" ToolTip="Minimize"
                                MouseLeftButtonDown="Minimize_Click" Background="Transparent">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#22FFFFFF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="&#x268A;" FontSize="11" Foreground="{StaticResource Muted2Brush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Border>
                        <!-- Maximize -->
                        <Border Width="46" Height="44" Cursor="Hand" ToolTip="Maximize"
                                MouseLeftButtonDown="Maximize_Click" Background="Transparent">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#22FFFFFF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock x:Name="MaximizeIcon" Text="&#x2610;" FontSize="11"
                                       Foreground="{StaticResource Muted2Brush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Border>
                        <!-- Close -->
                        <Border Width="46" Height="44" Cursor="Hand" ToolTip="Close"
                                MouseLeftButtonDown="Close_Click" Background="Transparent">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#CCEF4444"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="&#x2715;" FontSize="12" Foreground="{StaticResource Muted2Brush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver,
                                                RelativeSource={RelativeSource AncestorType=Border}}"
                                                Value="True">
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════ MAIN CONTENT ══════════════ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── SIDEBAR ── -->
                <Border Grid.Column="0"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Search -->
                        <Border Grid.Row="0" Padding="10,8">
                            <TextBox x:Name="SearchBox"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Foreground="{StaticResource TextBrush}"/>
                        </Border>

                        <!-- Filter pills -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10,0,10,10">
                                <TextBlock Text="FILTER" FontFamily="Consolas" FontSize="9"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="2,0,0,6" FontWeight="SemiBold"/>
                                <ItemsControl ItemsSource="{Binding FilterOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}"
                                                    Margin="0,2" HorizontalContentAlignment="Left"
                                                    Padding="10,6" FontSize="11"
                                                    Style="{StaticResource OutlineButton}"
                                                    Command="{Binding DataContext.SetFilterCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Active sessions list -->
                                <TextBlock Text="SESSIONS" FontFamily="Consolas" FontSize="9"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="2,14,0,6" FontWeight="SemiBold"/>

                                <TextBlock Text="No active sessions"
                                           FontFamily="Consolas" FontSize="10"
                                           Foreground="{StaticResource MutedBrush}"
                                           Visibility="{Binding HasNoSessions, Converter={StaticResource BoolVis}}"/>

                                <ItemsControl ItemsSource="{Binding Sessions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:TerminalSession}">
                                            <Border Margin="0,3" CornerRadius="7"
                                                    BorderThickness="1" Padding="8,7"
                                                    Cursor="Hand"
                                                    MouseLeftButtonDown="SessionSidebarItem_Click">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{StaticResource Accent3Brush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock FontFamily="Consolas" FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextBrush}"
                                                                   TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding PresetIcon}"/>
                                                            <Run Text=" "/>
                                                            <Run Text="{Binding PresetName}"/>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding StatusLabel}"
                                                                   FontFamily="Consolas" FontSize="9"
                                                                   Margin="0,2,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource Accent3Brush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                                                            <Setter Property="Foreground" Value="{StaticResource Muted2Brush}"/>
                                                                        </DataTrigger>
                                                                        <!-- HasError must come AFTER IsRunning=False so red wins over muted -->
                                                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="✕"
                                                            Style="{StaticResource DangerButton}"
                                                            Padding="5,2" FontSize="9"
                                                            Command="{Binding DataContext.CloseSessionCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Close all -->
                                <Button Content="■  Close All Sessions"
                                        Style="{StaticResource DangerButton}"
                                        Margin="0,8,0,0" Padding="10,7"
                                        Command="{Binding CloseAllSessionsCommand}"
                                        Visibility="{Binding HasNoSessions, Converter={StaticResource BoolVis}, ConverterParameter=invert}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- ── RIGHT PANEL: Presets + Terminal ── -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="200"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="280" MinHeight="140"/>
                    </Grid.RowDefinitions>

                    <!-- ── TOP: Tab panel (Presets / Custom) ── -->
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Tab header bar -->
                        <Border Grid.Row="0"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,0,0,1" Padding="14,6">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{StaticResource Surface2Brush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="4">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="TabPresetsHeader" CornerRadius="6" Padding="16,7"
                                                Cursor="Hand" MouseLeftButtonDown="Tab_Presets_Click">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock x:Name="TabPresetsText" Text="Presets"
                                                       FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="White"/>
                                        </Border>
                                        <Border x:Name="TabCustomHeader" CornerRadius="6" Padding="16,7"
                                                Cursor="Hand" MouseLeftButtonDown="Tab_Custom_Click">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock x:Name="TabCustomText" Text="+ Custom"
                                                       FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Muted2Brush}"/>
                                        </Border>
                                        <Border x:Name="TabTeamHeader" CornerRadius="6" Padding="16,7"
                                                Cursor="Hand" MouseLeftButtonDown="Tab_Team_Click">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Margin="0,0,6,0">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{StaticResource MutedBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsWorkspaceJoined}" Value="True">
                                                                    <Setter Property="Fill" Value="{StaticResource Accent3Brush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock x:Name="TabTeamText" Text="Team"
                                                           FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Muted2Brush}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="TabMonitorHeader" CornerRadius="6" Padding="16,7"
                                                Cursor="Hand" MouseLeftButtonDown="Tab_Monitor_Click">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="TabMonitorText" Text="Monitor"
                                                           FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Muted2Brush}"/>
                                                <Border CornerRadius="99" Padding="5,1" Margin="6,0,0,0"
                                                        Background="#1A2030">
                                                    <TextBlock Text="{Binding MonitorProcesses.Count}"
                                                               FontFamily="Consolas" FontSize="9"
                                                               Foreground="{StaticResource AccentBrush}"/>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Tab content -->
                        <Grid Grid.Row="1" Background="{StaticResource BgBrush}">

                            <!-- PRESETS panel -->
                            <ScrollViewer x:Name="PresetsPanel"
                                          VerticalScrollBarVisibility="Auto" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Launch Presets"
                                               FontFamily="Segoe UI" FontWeight="ExtraBold" FontSize="18"
                                               Foreground="{StaticResource TextBrush}" Margin="0,0,0,2"/>
                                    <TextBlock Text="Each launch opens a new terminal session below — run as many as you want simultaneously."
                                               FontFamily="Consolas" FontSize="10"
                                               Foreground="{StaticResource Muted2Brush}" Margin="0,0,0,14"/>

                                    <!-- Cards wrap panel -->
                                    <ItemsControl ItemsSource="{Binding FilteredPresets}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:LaunchPreset}">
                                                <Border Width="285" Margin="0,0,10,10"
                                                        Background="{StaticResource SurfaceBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="10"
                                                        Padding="14">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <!-- Card header -->
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                                <Border Width="34" Height="34"
                                                                        Background="{StaticResource Surface2Brush}"
                                                                        BorderBrush="{StaticResource BorderBrush}"
                                                                        BorderThickness="1" CornerRadius="7"
                                                                        Margin="0,0,8,0">
                                                                    <TextBlock Text="{Binding Icon}" FontSize="17"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>
                                                                </Border>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}"
                                                                               FontFamily="Segoe UI" FontWeight="Bold"
                                                                               FontSize="12"
                                                                               Foreground="{StaticResource TextBrush}"/>
                                                                    <Border CornerRadius="99" Padding="5,1"
                                                                            Margin="0,2,0,0" HorizontalAlignment="Left"
                                                                            Background="#1A1A2E" BorderThickness="1">
                                                                        <Border.BorderBrush>
                                                                            <Binding Path="Category" Converter="{StaticResource CatColor}"/>
                                                                        </Border.BorderBrush>
                                                                        <TextBlock Text="{Binding Category}"
                                                                                   FontFamily="Consolas" FontSize="9"
                                                                                   FontWeight="SemiBold">
                                                                            <TextBlock.Foreground>
                                                                                <Binding Path="Category" Converter="{StaticResource CatColor}"/>
                                                                            </TextBlock.Foreground>
                                                                        </TextBlock>
                                                                    </Border>
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Content="✕"
                                                                    Style="{StaticResource DangerButton}"
                                                                    Padding="5,2" FontSize="9"
                                                                    Visibility="{Binding IsCustom, Converter={StaticResource BoolVis}}"
                                                                    Command="{Binding DataContext.DeletePresetCommand,
                                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </Grid>

                                                        <TextBlock Text="{Binding Description}"
                                                                   FontFamily="Consolas" FontSize="10"
                                                                   Foreground="{StaticResource Muted2Brush}"
                                                                   TextWrapping="Wrap" Margin="0,0,0,8"
                                                                   MaxHeight="36" TextTrimming="CharacterEllipsis"/>

                                                        <!-- Commands -->
                                                        <ItemsControl ItemsSource="{Binding Commands}" Margin="0,0,0,10">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="{StaticResource BgBrush}"
                                                                            BorderBrush="{StaticResource BorderBrush}"
                                                                            BorderThickness="1" CornerRadius="5"
                                                                            Padding="7,3" Margin="0,2">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="$ " Foreground="{StaticResource AccentBrush}"
                                                                                       FontFamily="Consolas" FontSize="10"/>
                                                                            <TextBlock Text="{Binding Command}"
                                                                                       Foreground="{StaticResource Accent3Brush}"
                                                                                       FontFamily="Consolas" FontSize="10"
                                                                                       TextTrimming="CharacterEllipsis"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <!-- Working Directory row -->
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="6"/>
                                                                <ColumnDefinition Width="34"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0"
                                                                    Background="{StaticResource BgBrush}"
                                                                    BorderBrush="{StaticResource BorderBrush}"
                                                                    BorderThickness="1" CornerRadius="6"
                                                                    Padding="8,0" Height="32">
                                                                <TextBlock VerticalAlignment="Center"
                                                                           FontFamily="Consolas" FontSize="10"
                                                                           TextTrimming="CharacterEllipsis">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="{Binding WorkingDirectory}"/>
                                                                            <Setter Property="Foreground" Value="{StaticResource Accent3Brush}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding WorkingDirectory}" Value="">
                                                                                    <Setter Property="Text" Value="No directory set"/>
                                                                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                            <Button Grid.Column="2"
                                                                    Height="32" Width="34"
                                                                    ToolTip="Browse working directory"
                                                                    Style="{StaticResource OutlineButton}"
                                                                    Padding="0"
                                                                    Command="{Binding DataContext.BrowseWorkingDirCommand,
                                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}">
                                                                <TextBlock Text="📁" FontSize="14"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                            </Button>
                                                        </Grid>

                                                        <!-- Buttons -->
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="6"/>
                                                                <ColumnDefinition Width="36"/>
                                                                <ColumnDefinition Width="6"/>
                                                                <ColumnDefinition Width="36"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Button Grid.Column="0" Content="▶  Launch"
                                                                    Style="{StaticResource PrimaryButton}"
                                                                    FontSize="11"
                                                                    Command="{Binding DataContext.LaunchPresetCommand,
                                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"/>
                                                            <Button Grid.Column="2" Content="⎘"
                                                                    Style="{StaticResource OutlineButton}"
                                                                    ToolTip="Copy script" Padding="0,7"
                                                                    Command="{Binding DataContext.CopyScriptCommand,
                                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"/>
                                                            <Button Grid.Column="4" Content="↓"
                                                                    Style="{StaticResource OutlineButton}"
                                                                    ToolTip="Export .bat" Padding="0,7"
                                                                    Command="{Binding DataContext.ExportScriptCommand,
                                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- TEAM WORKSPACE panel -->
                            <ScrollViewer x:Name="TeamPanel" Visibility="Collapsed"
                                          VerticalScrollBarVisibility="Auto" Padding="28"
                                          Background="{StaticResource BgBrush}">
                                <StackPanel HorizontalAlignment="Stretch">
                                    <TextBlock Text="Team Workspace"
                                               FontFamily="Segoe UI" FontWeight="ExtraBold" FontSize="20"
                                               Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Share and sync presets with your team in real-time via Firebase"
                                               FontFamily="Consolas" FontSize="10"
                                               Foreground="{StaticResource Muted2Brush}" Margin="0,0,0,24"/>

                                    <!-- Connection status card -->
                                    <Border Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="10"
                                            Padding="18" Margin="0,0,0,20">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsWorkspaceJoined}" Value="True">
                                                                        <Setter Property="Fill" Value="{StaticResource Accent3Brush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                                                        <Setter Property="Fill" Value="{StaticResource WarnBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding WorkspaceStatus}"
                                                               FontFamily="Consolas" FontSize="11"
                                                               Foreground="{StaticResource TextBrush}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontFamily="Consolas" FontSize="10"
                                                               Foreground="{StaticResource Muted2Brush}"
                                                               Text="Workspace: "/>
                                                    <TextBlock FontFamily="Consolas" FontSize="10"
                                                               Foreground="{StaticResource AccentBrush}"
                                                               Text="{Binding WorkspaceCode}"/>
                                                    <TextBlock FontFamily="Consolas" FontSize="10"
                                                               Foreground="{StaticResource Muted2Brush}"
                                                               Text="  |  Synced: "/>
                                                    <TextBlock FontFamily="Consolas" FontSize="10"
                                                               Foreground="{StaticResource Accent3Brush}"
                                                               Text="{Binding TeamPresets.Count}"/>
                                                    <TextBlock FontFamily="Consolas" FontSize="10"
                                                               Foreground="{StaticResource Muted2Brush}"
                                                               Text=" presets"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource DangerButton}"
                                                    Content="Disconnect" Padding="14,8"
                                                    Visibility="{Binding IsWorkspaceJoined, Converter={StaticResource BoolVis}}"
                                                    Command="{Binding DisconnectWorkspaceCommand}"/>
                                        </Grid>
                                    </Border>

                                    <!-- Create / Join workspace form (shown when not joined) -->
                                    <Border Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="10"
                                            Padding="18" Margin="0,0,0,20"
                                            Visibility="{Binding IsWorkspaceJoined, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                                        <StackPanel>

                                            <!-- Mode switcher tabs: Create / Join -->
                                            <Border Background="{StaticResource Surface2Brush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="8"
                                                    Padding="4" Margin="0,0,0,20" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal">
                                                    <!-- Create tab -->
                                                    <Border x:Name="WsCreateTab" CornerRadius="6" Padding="20,7"
                                                            Cursor="Hand" MouseLeftButtonDown="WsTab_Create_Click">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#7C3AED" Offset="0"/>
                                                                <GradientStop Color="#00E5FF" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <TextBlock x:Name="WsCreateTabText" Text="✦  Create Workspace"
                                                                   FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="White"/>
                                                    </Border>
                                                    <!-- Join tab -->
                                                    <Border x:Name="WsJoinTab" CornerRadius="6" Padding="20,7"
                                                            Background="Transparent"
                                                            Cursor="Hand" MouseLeftButtonDown="WsTab_Join_Click">
                                                        <TextBlock x:Name="WsJoinTabText" Text="🔗  Join Workspace"
                                                                   FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource Muted2Brush}"/>
                                                    </Border>
                                                </StackPanel>
                                            </Border>

                                            <!-- ══ CREATE PANEL ══ -->
                                            <StackPanel x:Name="WsCreatePanel">
                                                <TextBlock FontFamily="Consolas" FontSize="10"
                                                           Foreground="{StaticResource Muted2Brush}"
                                                           Margin="0,0,0,16" TextWrapping="Wrap"
                                                           Text="Create a new workspace for your team. Share the code with teammates so they can join and sync presets in real-time."/>

                                                <!-- Name + Code row -->
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="WORKSPACE NAME" FontFamily="Consolas" FontSize="9"
                                                                   FontWeight="SemiBold" Foreground="{StaticResource Muted2Brush}" Margin="0,0,0,6"/>
                                                        <TextBox Text="{Binding NewWorkspaceName, UpdateSourceTrigger=PropertyChanged}"
                                                                 Height="40" FontSize="12" Padding="10,0"
                                                                 VerticalContentAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="WORKSPACE CODE" FontFamily="Consolas" FontSize="9"
                                                                   FontWeight="SemiBold" Foreground="{StaticResource Muted2Brush}" Margin="0,0,0,6"/>
                                                        <TextBox Text="{Binding WorkspaceCode, UpdateSourceTrigger=PropertyChanged}"
                                                                 Height="40" FontSize="14" Padding="10,0"
                                                                 VerticalContentAlignment="Center"
                                                                 Foreground="{StaticResource AccentBrush}"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Display name -->
                                                <StackPanel Margin="0,0,0,16">
                                                    <TextBlock Text="YOUR DISPLAY NAME" FontFamily="Consolas" FontSize="9"
                                                               FontWeight="SemiBold" Foreground="{StaticResource Muted2Brush}" Margin="0,0,0,6"/>
                                                    <TextBox Text="{Binding UserDisplayName, UpdateSourceTrigger=PropertyChanged}"
                                                             Height="40" FontSize="12" Padding="10,0"
                                                             VerticalContentAlignment="Center"/>
                                                </StackPanel>

                                                <!-- Tip box -->
                                                <Border Background="#0D7C3AED" BorderBrush="#337C3AED"
                                                        BorderThickness="1" CornerRadius="7" Padding="12,10" Margin="0,0,0,16">
                                                    <TextBlock FontFamily="Consolas" FontSize="10"
                                                               Foreground="#AA7C3AED" TextWrapping="Wrap">
                                                        <Run Text="💡 Tip: "/>
                                                        <Run Text="The workspace code is what you share with teammates. Use something memorable like "/>
                                                        <Run Text="ACME-DEV" Foreground="{StaticResource AccentBrush}"/>
                                                        <Run Text=" or "/>
                                                        <Run Text="MYTEAM-2024" Foreground="{StaticResource AccentBrush}"/>
                                                        <Run Text=". It is case-insensitive."/>
                                                    </TextBlock>
                                                </Border>

                                                <Button Height="42" FontSize="13"
                                                        Command="{Binding CreateWorkspaceCommand}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                            <Setter Property="Content" Value="✦   Create Workspace"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                                                    <Setter Property="IsEnabled" Value="False"/>
                                                                    <Setter Property="Content" Value="⏳  Creating..."/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>

                                            <!-- ══ JOIN PANEL ══ -->
                                            <StackPanel x:Name="WsJoinPanel" Visibility="Collapsed">
                                                <TextBlock FontFamily="Consolas" FontSize="10"
                                                           Foreground="{StaticResource Muted2Brush}"
                                                           Margin="0,0,0,16" TextWrapping="Wrap"
                                                           Text="Enter the workspace code your team lead shared with you to join and sync presets in real-time."/>

                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="WORKSPACE CODE" FontFamily="Consolas" FontSize="9"
                                                                   FontWeight="SemiBold" Foreground="{StaticResource Muted2Brush}" Margin="0,0,0,6"/>
                                                        <TextBox Text="{Binding WorkspaceCode, UpdateSourceTrigger=PropertyChanged}"
                                                                 Height="40" FontSize="14" Padding="10,0"
                                                                 VerticalContentAlignment="Center"
                                                                 Foreground="{StaticResource AccentBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="YOUR DISPLAY NAME" FontFamily="Consolas" FontSize="9"
                                                                   FontWeight="SemiBold" Foreground="{StaticResource Muted2Brush}" Margin="0,0,0,6"/>
                                                        <TextBox Text="{Binding UserDisplayName, UpdateSourceTrigger=PropertyChanged}"
                                                                 Height="40" FontSize="12" Padding="10,0"
                                                                 VerticalContentAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>

                                                <Button Height="42" FontSize="13"
                                                        Command="{Binding ConnectWorkspaceCommand}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                            <Setter Property="Content" Value="🔗   Join Workspace"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                                                    <Setter Property="IsEnabled" Value="False"/>
                                                                    <Setter Property="Content" Value="⏳  Joining..."/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <TextBlock Text="No account needed — just enter the code your team lead shared."
                                                           FontFamily="Consolas" FontSize="10"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                            </StackPanel>

                                        </StackPanel>
                                    </Border>

                                    <!-- Team presets list (shown when joined) -->
                                    <Border Visibility="{Binding IsWorkspaceJoined, Converter={StaticResource BoolVis}}">
                                        <StackPanel>
                                            <TextBlock Text="TEAM PRESETS" FontFamily="Consolas" FontSize="9"
                                                       FontWeight="SemiBold" Foreground="{StaticResource Muted2Brush}"
                                                       Margin="0,0,0,12"/>

                                            <TextBlock Text="No team presets yet. Share a local preset to get started."
                                                       FontFamily="Consolas" FontSize="11"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       Margin="0,8,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TeamPresets.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <ItemsControl ItemsSource="{Binding TeamPresets}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:LaunchPreset}">
                                                        <Border Width="285" Margin="0,0,10,10"
                                                                Background="{StaticResource SurfaceBrush}"
                                                                BorderThickness="1" CornerRadius="10"
                                                                Padding="14">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BorderBrush" Value="{StaticResource Accent3Brush}"/>
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <!-- Header -->
                                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                                    <Border Width="34" Height="34"
                                                                            Background="{StaticResource Surface2Brush}"
                                                                            BorderBrush="{StaticResource BorderBrush}"
                                                                            BorderThickness="1" CornerRadius="7"
                                                                            Margin="0,0,8,0">
                                                                        <TextBlock Text="{Binding Icon}" FontSize="17"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <StackPanel VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Name}"
                                                                                   FontFamily="Segoe UI" FontWeight="Bold"
                                                                                   FontSize="12" Foreground="{StaticResource TextBrush}"/>
                                                                        <TextBlock FontFamily="Consolas" FontSize="9"
                                                                                   Foreground="{StaticResource Muted2Brush}">
                                                                            <Run Text="by "/>
                                                                            <Run Text="{Binding LastEditedBy}" Foreground="{StaticResource AccentBrush}"/>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                </StackPanel>

                                                                <TextBlock Text="{Binding Description}"
                                                                           FontFamily="Consolas" FontSize="10"
                                                                           Foreground="{StaticResource Muted2Brush}"
                                                                           TextWrapping="Wrap" Margin="0,0,0,8"
                                                                           MaxHeight="32" TextTrimming="CharacterEllipsis"/>

                                                                <!-- Commands preview -->
                                                                <ItemsControl ItemsSource="{Binding Commands}" Margin="0,0,0,10">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Background="{StaticResource BgBrush}"
                                                                                    BorderBrush="{StaticResource BorderBrush}"
                                                                                    BorderThickness="1" CornerRadius="5"
                                                                                    Padding="7,3" Margin="0,2">
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <TextBlock Text="$ " Foreground="{StaticResource AccentBrush}"
                                                                                               FontFamily="Consolas" FontSize="10"/>
                                                                                    <TextBlock Text="{Binding Command}"
                                                                                               Foreground="{StaticResource Accent3Brush}"
                                                                                               FontFamily="Consolas" FontSize="10"
                                                                                               TextTrimming="CharacterEllipsis"/>
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>

                                                                <!-- Actions -->
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="6"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="6"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Button Grid.Column="0" Content="▶  Launch"
                                                                            Style="{StaticResource PrimaryButton}" FontSize="11"
                                                                            Command="{Binding DataContext.LaunchPresetCommand,
                                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}"/>
                                                                    <Button Grid.Column="2" Content="⬇ Pull"
                                                                            Style="{StaticResource OutlineButton}"
                                                                            ToolTip="Save as local preset" Padding="10,7"
                                                                            Command="{Binding DataContext.PullTeamPresetCommand,
                                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}"/>
                                                                    <Button Grid.Column="4" Content="✕"
                                                                            Style="{StaticResource DangerButton}"
                                                                            Padding="8,7"
                                                                            ToolTip="Delete from workspace"
                                                                            Command="{Binding DataContext.DeleteTeamPresetCommand,
                                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}"/>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Share local preset section -->
                                    <Border Margin="0,16,0,0"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="10" Padding="18"
                                            Visibility="{Binding IsWorkspaceJoined, Converter={StaticResource BoolVis}}">
                                        <StackPanel>
                                            <TextBlock Text="SHARE A LOCAL PRESET" FontFamily="Consolas" FontSize="9"
                                                       FontWeight="SemiBold" Foreground="{StaticResource Muted2Brush}"
                                                       Margin="0,0,0,12"/>
                                            <TextBlock Text="Pick any of your local presets below and push it to the team workspace."
                                                       FontFamily="Consolas" FontSize="10"
                                                       Foreground="{StaticResource Muted2Brush}" Margin="0,0,0,12"/>
                                            <ItemsControl ItemsSource="{Binding AllPresets}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:LaunchPreset}">
                                                        <Border Background="{StaticResource BgBrush}"
                                                                BorderBrush="{StaticResource BorderBrush}"
                                                                BorderThickness="1" CornerRadius="7"
                                                                Padding="10,8" Margin="0,3">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Icon}"
                                                                           FontSize="16" Margin="0,0,10,0"
                                                                           VerticalAlignment="Center"/>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}"
                                                                               FontFamily="Consolas" FontSize="11"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{StaticResource TextBrush}"/>
                                                                    <TextBlock Text="{Binding Category}"
                                                                               FontFamily="Consolas" FontSize="9"
                                                                               Foreground="{StaticResource Muted2Brush}"/>
                                                                </StackPanel>
                                                                <Button Grid.Column="2" Content="⬆ Share"
                                                                        Style="{StaticResource GreenButton}"
                                                                        Padding="12,6" FontSize="10"
                                                                        Command="{Binding DataContext.SharePresetCommand,
                                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- MONITOR panel -->
                            <ScrollViewer x:Name="MonitorPanel" Visibility="Collapsed"
                                          VerticalScrollBarVisibility="Auto"
                                          Background="{StaticResource BgBrush}">
                                <StackPanel Margin="28">
                                    <TextBlock Text="Process Monitor"
                                               FontFamily="Segoe UI" FontWeight="ExtraBold" FontSize="20"
                                               Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Live health metrics for all running session processes — refreshed every 2 seconds"
                                               FontFamily="Consolas" FontSize="10"
                                               Foreground="{StaticResource Muted2Brush}" Margin="0,0,0,20"/>

                                    <!-- Empty state -->
                                    <Border Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="10" Padding="28,24">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MonitorProcesses.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="No active processes. Launch a preset above to start monitoring."
                                                   FontFamily="Consolas" FontSize="11"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   HorizontalAlignment="Center"/>
                                    </Border>

                                    <!-- Process table -->
                                    <Border Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MonitorProcesses.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>

                                            <!-- Table header -->
                                            <Border Background="{StaticResource Surface2Brush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    CornerRadius="10,10,0,0" Padding="14,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28"/>
                                                        <ColumnDefinition Width="160"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="64"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"/>
                                                    <TextBlock Grid.Column="1" Text="SESSION"
                                                               FontFamily="Consolas" FontSize="9" FontWeight="SemiBold"
                                                               Foreground="{StaticResource Muted2Brush}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="PROCESS"
                                                               FontFamily="Consolas" FontSize="9" FontWeight="SemiBold"
                                                               Foreground="{StaticResource Muted2Brush}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="PID"
                                                               FontFamily="Consolas" FontSize="9" FontWeight="SemiBold"
                                                               Foreground="{StaticResource Muted2Brush}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="4" Text="CPU %"
                                                               FontFamily="Consolas" FontSize="9" FontWeight="SemiBold"
                                                               Foreground="{StaticResource Muted2Brush}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="5" Text="MEMORY"
                                                               FontFamily="Consolas" FontSize="9" FontWeight="SemiBold"
                                                               Foreground="{StaticResource Muted2Brush}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="6" Text="UPTIME"
                                                               FontFamily="Consolas" FontSize="9" FontWeight="SemiBold"
                                                               Foreground="{StaticResource Muted2Brush}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="7"/>
                                                </Grid>
                                            </Border>

                                            <!-- Table rows -->
                                            <ItemsControl ItemsSource="{Binding MonitorProcesses}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:ProcessMonitorItem}">
                                                        <Border BorderBrush="{StaticResource BorderBrush}"
                                                                BorderThickness="0,0,0,1" Padding="14,11">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="28"/>
                                                                    <ColumnDefinition Width="160"/>
                                                                    <ColumnDefinition Width="120"/>
                                                                    <ColumnDefinition Width="70"/>
                                                                    <ColumnDefinition Width="80"/>
                                                                    <ColumnDefinition Width="100"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="64"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0" Text="{Binding SessionIcon}"
                                                                           FontSize="13" VerticalAlignment="Center"/>

                                                                <TextBlock Grid.Column="1" Text="{Binding SessionName}"
                                                                           FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextBrush}"
                                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                                                <TextBlock Grid.Column="2" Text="{Binding ProcessName}"
                                                                           FontFamily="Consolas" FontSize="11"
                                                                           Foreground="{StaticResource AccentBrush}"
                                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                                                <TextBlock Grid.Column="3" Text="{Binding Pid}"
                                                                           FontFamily="Consolas" FontSize="11"
                                                                           Foreground="{StaticResource Muted2Brush}"
                                                                           VerticalAlignment="Center"/>

                                                                <TextBlock Grid.Column="4"
                                                                           Text="{Binding CpuPercent, StringFormat={}{0:F1}%}"
                                                                           FontFamily="Consolas" FontSize="11"
                                                                           Foreground="{StaticResource Accent3Brush}"
                                                                           VerticalAlignment="Center"/>

                                                                <TextBlock Grid.Column="5"
                                                                           Text="{Binding MemoryMb, StringFormat={}{0} MB}"
                                                                           FontFamily="Consolas" FontSize="11"
                                                                           Foreground="{StaticResource WarnBrush}"
                                                                           VerticalAlignment="Center"/>

                                                                <TextBlock Grid.Column="6" Text="{Binding Uptime}"
                                                                           FontFamily="Consolas" FontSize="11"
                                                                           Foreground="{StaticResource Muted2Brush}"
                                                                           VerticalAlignment="Center"/>

                                                                <Button Grid.Column="7" Content="✕ Kill"
                                                                        Style="{StaticResource DangerButton}"
                                                                        Padding="6,4" FontSize="9"
                                                                        VerticalAlignment="Center"
                                                                        Command="{Binding DataContext.KillMonitorProcessCommand,
                                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- CUSTOM BUILD panel -->
                            <ScrollViewer x:Name="CustomPanel" Visibility="Collapsed"
                                          VerticalScrollBarVisibility="Auto" Padding="28">
                                <StackPanel HorizontalAlignment="Stretch">
                                    <TextBlock Text="Build Your Own Setup"
                                               FontFamily="Segoe UI" FontWeight="ExtraBold" FontSize="20"
                                               Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Configure commands, working directory, and auto-open URL"
                                               FontFamily="Consolas" FontSize="10"
                                               Foreground="{StaticResource Muted2Brush}" Margin="0,0,0,24"/>

                                    <!-- Row 1: Name + Icon -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="PRESET NAME" FontFamily="Consolas" FontSize="9" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Muted2Brush}" Margin="2,0,0,6"/>
                                            <TextBox Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="40" FontSize="13" Padding="10,0"
                                                     VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="ICON" FontFamily="Consolas" FontSize="9" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Muted2Brush}" Margin="2,0,0,6"/>
                                            <!-- Icon picker button + popup -->
                                            <Grid>
                                                <Button x:Name="IconPickerBtn"
                                                        Height="40" FontSize="22"
                                                        Content="{Binding NewPresetIcon}"
                                                        Style="{StaticResource OutlineButton}"
                                                        Padding="0" ToolTip="Click to pick icon"
                                                        Click="IconPickerBtn_Click"/>
                                                <Popup x:Name="IconPickerPopup"
                                                       PlacementTarget="{Binding ElementName=IconPickerBtn}"
                                                       Placement="Bottom"
                                                       AllowsTransparency="True"
                                                       StaysOpen="False"
                                                       PopupAnimation="Fade">
                                                    <local:IconPickerPopup x:Name="IconPickerControl"/>
                                                </Popup>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Row 2: Category (full themed dropdown) -->
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Text="CATEGORY" FontFamily="Consolas" FontSize="9" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Muted2Brush}" Margin="2,0,0,6"/>
                                        <ComboBox ItemsSource="{Binding Categories}"
                                                  SelectedItem="{Binding NewPresetCategory}"
                                                  Height="40" FontSize="12"
                                                  Background="{StaticResource BgBrush}"
                                                  Foreground="{StaticResource TextBrush}"
                                                  BorderBrush="{StaticResource BorderBrush}"
                                                  BorderThickness="1" Padding="10,0">
                                            <ComboBox.Template>
                                                <ControlTemplate TargetType="ComboBox">
                                                    <Grid>
                                                        <Border x:Name="border"
                                                                Background="{StaticResource BgBrush}"
                                                                BorderBrush="{StaticResource BorderBrush}"
                                                                BorderThickness="1" CornerRadius="7">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="36"/>
                                                                </Grid.ColumnDefinitions>
                                                                <ContentPresenter Grid.Column="0"
                                                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                                                  Margin="10,0,0,0"
                                                                                  VerticalAlignment="Center"/>
                                                                <Border Grid.Column="1"
                                                                        BorderBrush="{StaticResource BorderBrush}"
                                                                        BorderThickness="1,0,0,0">
                                                                    <TextBlock Text="▾" FontSize="12"
                                                                               Foreground="{StaticResource Muted2Brush}"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ToggleButton Grid.Column="0" Grid.ColumnSpan="2"
                                                                              Focusable="False"
                                                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                                                          RelativeSource={RelativeSource TemplatedParent}}"
                                                                              Background="Transparent"
                                                                              BorderThickness="0"
                                                                              Opacity="0"/>
                                                            </Grid>
                                                        </Border>
                                                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                                               Placement="Bottom"
                                                               AllowsTransparency="True"
                                                               Focusable="False"
                                                               PopupAnimation="Fade">
                                                            <Border Background="{StaticResource SurfaceBrush}"
                                                                    BorderBrush="{StaticResource AccentBrush}"
                                                                    BorderThickness="1" CornerRadius="7"
                                                                    MinWidth="{Binding ActualWidth,
                                                                              RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                    Margin="0,4,0,0">
                                                                <Border.Effect>
                                                                    <DropShadowEffect Color="#000000" BlurRadius="16"
                                                                                      ShadowDepth="4" Opacity="0.4"/>
                                                                </Border.Effect>
                                                                <ScrollViewer SnapsToDevicePixels="True"
                                                                              MaxHeight="180">
                                                                    <ItemsPresenter/>
                                                                </ScrollViewer>
                                                            </Border>
                                                        </Popup>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="BorderBrush"
                                                                    Value="{StaticResource AccentBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsDropDownOpen" Value="True">
                                                            <Setter TargetName="border" Property="BorderBrush"
                                                                    Value="{StaticResource AccentBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ComboBox.Template>
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="12,10" Background="Transparent">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding}"
                                                                   FontFamily="Consolas" FontSize="12"
                                                                   Foreground="{StaticResource TextBrush}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Row 3: Description -->
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Text="DESCRIPTION" FontFamily="Consolas" FontSize="9" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Muted2Brush}" Margin="2,0,0,6"/>
                                        <TextBox Text="{Binding NewPresetDescription, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="40" FontSize="12" Padding="10,0"
                                                 VerticalContentAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Row 4: Working dir + URL -->
                                    <Grid Margin="0,0,0,20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="WORKING DIRECTORY" FontFamily="Consolas" FontSize="9" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Muted2Brush}" Margin="2,0,0,6"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="42"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0"
                                                         Text="{Binding NewPresetWorkingDir, UpdateSourceTrigger=PropertyChanged}"
                                                         Height="40" FontSize="12" Padding="10,0"
                                                         VerticalContentAlignment="Center"/>
                                                <Button Grid.Column="2"
                                                        Height="40" Width="42"
                                                        ToolTip="Browse for folder"
                                                        Style="{StaticResource OutlineButton}"
                                                        Padding="0"
                                                        Click="BrowseNewPresetDir_Click">
                                                    <TextBlock Text="📁" FontSize="16"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="OPEN URL AFTER LAUNCH" FontFamily="Consolas" FontSize="9" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Muted2Brush}" Margin="2,0,0,6"/>
                                            <TextBox Text="{Binding NewPresetOpenUrl, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="40" FontSize="12" Padding="10,0"
                                                     VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Row 5: Commands -->
                                    <TextBlock Text="TERMINAL COMMANDS" FontFamily="Consolas" FontSize="9" FontWeight="SemiBold"
                                               Foreground="{StaticResource Muted2Brush}" Margin="2,0,0,8"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding NewCommandText, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="40" FontSize="12" Padding="10,0"
                                                 VerticalContentAlignment="Center"
                                                 Foreground="{StaticResource Accent3Brush}">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Return" Command="{Binding AddCommandCommand}"/>
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <Button Grid.Column="2" Content="+ Add"
                                                Style="{StaticResource GreenButton}"
                                                Height="40" FontSize="12"
                                                Command="{Binding AddCommandCommand}"/>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding NewPresetCommands}" Margin="0,0,0,18">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource BgBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="6"
                                                        Padding="9,6" Margin="0,3">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="$ "
                                                                   Foreground="{StaticResource AccentBrush}"
                                                                   FontFamily="Consolas" FontSize="11"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding}"
                                                                   Foreground="{StaticResource Accent3Brush}"
                                                                   FontFamily="Consolas" FontSize="11"/>
                                                        <Button Grid.Column="2" Content="✕"
                                                                Style="{StaticResource DangerButton}"
                                                                Padding="5,2" FontSize="9"
                                                                Command="{Binding DataContext.RemoveCommandCommand,
                                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button Content="💾   Save Preset"
                                            Style="{StaticResource GreenButton}"
                                            Height="40" FontSize="13" FontWeight="Bold"
                                            Command="{Binding SaveCustomPresetCommand}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- ── SPLITTER ── -->
                    <GridSplitter Grid.Row="1"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  Background="{StaticResource BorderBrush}"
                                  Cursor="SizeNS"/>

                    <!-- ══════════════ TERMINAL PANEL ══════════════ -->
                    <Border Grid.Row="2"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Terminal tab bar -->
                            <Border Grid.Row="0"
                                    Background="{StaticResource Surface2Brush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Session tabs scroll -->
                                    <ScrollViewer Grid.Column="0"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Disabled">
                                        <StackPanel Orientation="Horizontal" x:Name="SessionTabBar">
                                            <!-- Empty state label -->
                                            <TextBlock Text="No sessions — click ▶ Launch on any preset above"
                                                       FontFamily="Consolas" FontSize="10"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       VerticalAlignment="Center" Margin="14,0"
                                                       Visibility="{Binding HasNoSessions, Converter={StaticResource BoolVis}}"/>

                                            <ItemsControl ItemsSource="{Binding Sessions}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:TerminalSession}">
                                                        <Border x:Name="sessionTab"
                                                                Padding="12,0,6,0"
                                                                BorderBrush="{StaticResource BorderBrush}"
                                                                BorderThickness="0,0,1,0"
                                                                Cursor="Hand"
                                                                MouseLeftButtonDown="SessionTab_Click">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <!-- Running pulse dot -->
                                                                <Ellipse Width="6" Height="6" Margin="0,0,6,0">
                                                                    <Ellipse.Style>
                                                                        <Style TargetType="Ellipse">
                                                                            <Setter Property="Fill" Value="{StaticResource Muted2Brush}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                                    <Setter Property="Fill" Value="{StaticResource Accent3Brush}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                                    <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Ellipse.Style>
                                                                </Ellipse>
                                                                <TextBlock FontFamily="Consolas" FontSize="11"
                                                                           VerticalAlignment="Center"
                                                                           MaxWidth="130"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Foreground="{StaticResource Muted2Brush}">
                                                                    <Run Text="{Binding PresetIcon}"/>
                                                                    <Run Text=" "/>
                                                                    <Run Text="{Binding PresetName}"/>
                                                                </TextBlock>
                                                                <Button Content="✕" Margin="6,0,0,0"
                                                                        Style="{StaticResource DangerButton}"
                                                                        Padding="3,1" FontSize="8"
                                                                        Command="{Binding DataContext.CloseSessionCommand,
                                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <!-- Clear button -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,0">
                                        <Button Content="clear"
                                                Style="{StaticResource BaseButton}"
                                                Background="Transparent"
                                                Foreground="{StaticResource MutedBrush}"
                                                FontSize="10" Padding="8,4"
                                                Command="{Binding ClearSessionCommand}"
                                                CommandParameter="{Binding ActiveSession}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Terminal output grid — search bar + output -->
                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- ── Inline Search Bar (Ctrl+F) ── -->
                                <Border x:Name="TerminalSearchBar"
                                        Grid.Row="0"
                                        Visibility="Collapsed"
                                        Background="#0D0F14"
                                        BorderBrush="{StaticResource AccentBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="10,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Search icon label -->
                                        <TextBlock Grid.Column="0" Text="🔍"
                                                   FontSize="12" VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>

                                        <!-- Search input -->
                                        <TextBox Grid.Column="1"
                                                 x:Name="TerminalSearchBox"
                                                 Height="28" FontSize="12"
                                                 Padding="8,0"
                                                 VerticalContentAlignment="Center"
                                                 Background="#0A0C10"
                                                 Foreground="{StaticResource TextBrush}"
                                                 BorderBrush="{StaticResource BorderBrush}"
                                                 CaretBrush="{StaticResource AccentBrush}"
                                                 TextChanged="TerminalSearch_TextChanged">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="F3"             Command="{Binding NextMatchCommand}"/>
                                                <KeyBinding Key="F3" Modifiers="Shift" Command="{Binding PrevMatchCommand}"/>
                                                <KeyBinding Key="Escape"         Command="{Binding CloseSearchCommand}"/>
                                            </TextBox.InputBindings>
                                        </TextBox>

                                        <!-- Match counter -->
                                        <TextBlock Grid.Column="2"
                                                   x:Name="MatchCountLabel"
                                                   Text="0 matches"
                                                   FontFamily="Consolas" FontSize="10"
                                                   Foreground="{StaticResource Muted2Brush}"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0"/>

                                        <!-- Prev / Next buttons -->
                                        <Button Grid.Column="3" Content="▲"
                                                Style="{StaticResource OutlineButton}"
                                                Height="28" Padding="8,0" FontSize="10"
                                                ToolTip="Previous match (Shift+F3)"
                                                Click="SearchPrev_Click"/>
                                        <Button Grid.Column="4" Content="▼"
                                                Style="{StaticResource OutlineButton}"
                                                Height="28" Padding="8,0" FontSize="10"
                                                Margin="4,0,0,0" ToolTip="Next match (F3)"
                                                Click="SearchNext_Click"/>

                                        <!-- Close button -->
                                        <Button Grid.Column="5" Content="✕"
                                                Style="{StaticResource DangerButton}"
                                                Height="28" Padding="8,0" FontSize="10"
                                                Margin="8,0,0,0" ToolTip="Close search (Esc)"
                                                Click="SearchClose_Click"/>
                                    </Grid>
                                </Border>

                                <!-- No session placeholder -->
                                <Border Grid.Row="1" Background="{StaticResource BgBrush}"
                                        Visibility="{Binding HasNoSessions, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="No session selected. Launch a preset to see output here."
                                               FontFamily="Consolas" FontSize="11"
                                               Foreground="{StaticResource MutedBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Terminal output — ItemsControl with highlight support -->
                                <ScrollViewer Grid.Row="1" x:Name="TerminalScroll"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto"
                                              Padding="12,8"
                                              Background="{StaticResource BgBrush}"
                                              Visibility="{Binding HasNoSessions, Converter={StaticResource BoolVis}, ConverterParameter=invert}"
                                              KeyDown="TerminalScroll_KeyDown"
                                              PreviewTextInput="TerminalScroll_TextInput"
                                              MouseDown="TerminalScroll_MouseDown"
                                              Focusable="True">
                                    <StackPanel>
                                        <ItemsControl x:Name="TerminalOutput"
                                                      ItemsSource="{Binding ActiveSession.Lines}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:TerminalLine}">
                                                    <TextBlock x:Name="TermLine"
                                                               Text="{Binding Text}"
                                                               FontFamily="Consolas"
                                                               FontSize="11"
                                                               TextWrapping="Wrap"
                                                               Tag="{Binding}">
                                                        <TextBlock.Foreground>
                                                            <Binding Path="Type" Converter="{StaticResource TermColor}"/>
                                                        </TextBlock.Foreground>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Shell-ready cursor — appears after last output line when
                                             the interactive shell is active and waiting for input -->
                                        <TextBlock Text="▌"
                                                   FontFamily="Consolas" FontSize="12"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   Margin="0,2,0,4"
                                                   Visibility="{Binding ShellCursorVisible, Converter={StaticResource BoolVis}}">
                                            <TextBlock.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             From="1" To="0" Duration="0:0:0.5"
                                                                             AutoReverse="True"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </TextBlock.Triggers>
                                        </TextBlock>
                                    </StackPanel>
                                </ScrollViewer>

                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ══════════════ STATUS BAR ══════════════ -->
            <Border Grid.Row="2"
                    Background="{StaticResource Surface2Brush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="14,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                               FontFamily="Consolas" FontSize="10"
                               Foreground="{StaticResource Muted2Brush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="DevLauncher v1.0 — .NET 8 WPF"
                               FontFamily="Consolas" FontSize="10"
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
