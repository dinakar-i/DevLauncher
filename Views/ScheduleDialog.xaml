<Window x:Class="DevLauncher.Views.ScheduleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Schedule Preset"
        Width="430" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{StaticResource BgBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome ResizeBorderThickness="0" CaptionHeight="40"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Dark skin for the DatePicker text box -->
        <Style TargetType="DatePickerTextBox">
            <Setter Property="Background"               Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground"               Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush"              Value="{StaticResource BorderBrush}"/>
            <Setter Property="CaretBrush"               Value="{StaticResource AccentBrush}"/>
            <Setter Property="SelectionBrush"           Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontFamily"               Value="Consolas"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="Padding"                  Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- Dark skin for the calendar popup -->
        <Style TargetType="Calendar">
            <Setter Property="Background"      Value="{StaticResource Surface2Brush}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="CalendarDayButton">
            <Setter Property="Foreground"  Value="{StaticResource TextBrush}"/>
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="FontFamily"  Value="Consolas"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="Width"       Value="32"/>
            <Setter Property="Height"      Value="26"/>
        </Style>
        <Style TargetType="CalendarButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── Title bar ── -->
            <Border Grid.Row="0"
                    Background="{StaticResource Surface2Brush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" VerticalAlignment="Center"
                               FontFamily="Consolas" FontSize="12">
                        <Run Text="⏰  Schedule — " Foreground="{StaticResource Muted2Brush}"/>
                        <Run x:Name="TitlePresetName" Foreground="{StaticResource AccentBrush}"/>
                    </TextBlock>

                    <Border Grid.Column="1" Width="40" Height="40" Cursor="Hand"
                            MouseLeftButtonDown="CloseBtn_Click" Background="Transparent"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#CCEF4444"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="✕" FontSize="11" Foreground="{StaticResource Muted2Brush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ── Content ── -->
            <StackPanel Grid.Row="1" Margin="24,20,24,24">

                <!-- Schedule type pills -->
                <TextBlock Text="SCHEDULE TYPE" FontFamily="Consolas" FontSize="9"
                           FontWeight="SemiBold" Foreground="{StaticResource Muted2Brush}"
                           Margin="0,0,0,10"/>

                <Border Background="{StaticResource Surface2Brush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="4">
                    <WrapPanel>
                        <Border x:Name="TypeNone" CornerRadius="6" Padding="14,7"
                                Cursor="Hand" MouseLeftButtonDown="TypeNone_Click">
                            <TextBlock x:Name="TypeNoneText" Text="None"
                                       FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <Border x:Name="TypeStartup" CornerRadius="6" Padding="14,7"
                                Cursor="Hand" MouseLeftButtonDown="TypeStartup_Click">
                            <TextBlock x:Name="TypeStartupText" Text="⚡ Startup"
                                       FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <Border x:Name="TypeOnce" CornerRadius="6" Padding="14,7"
                                Cursor="Hand" MouseLeftButtonDown="TypeOnce_Click">
                            <TextBlock x:Name="TypeOnceText" Text="Once"
                                       FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <Border x:Name="TypeDaily" CornerRadius="6" Padding="14,7"
                                Cursor="Hand" MouseLeftButtonDown="TypeDaily_Click">
                            <TextBlock x:Name="TypeDailyText" Text="Daily"
                                       FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <Border x:Name="TypeWeekdays" CornerRadius="6" Padding="14,7"
                                Cursor="Hand" MouseLeftButtonDown="TypeWeekdays_Click">
                            <TextBlock x:Name="TypeWeekdaysText" Text="Weekdays"
                                       FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </WrapPanel>
                </Border>

                <!-- Time section — Daily, Weekdays, Once -->
                <StackPanel x:Name="TimeSection" Margin="0,20,0,0" Visibility="Collapsed">
                    <TextBlock Text="RUN AT" FontFamily="Consolas" FontSize="9"
                               FontWeight="SemiBold" Foreground="{StaticResource Muted2Brush}"
                               Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">

                        <!-- Hour spinner -->
                        <StackPanel Width="64">
                            <Button Content="▲" Click="HourUp_Click"
                                    Style="{StaticResource OutlineButton}"
                                    Height="26" Padding="0" FontSize="10"
                                    Foreground="{StaticResource AccentBrush}"/>
                            <Border Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource AccentBrush}"
                                    BorderThickness="1" CornerRadius="6"
                                    Height="44" Margin="0,4">
                                <TextBlock x:Name="HourDisplay" Text="09"
                                           FontFamily="Consolas" FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Button Content="▼" Click="HourDown_Click"
                                    Style="{StaticResource OutlineButton}"
                                    Height="26" Padding="0" FontSize="10"
                                    Foreground="{StaticResource AccentBrush}"/>
                        </StackPanel>

                        <TextBlock Text=":" FontFamily="Consolas" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource Muted2Brush}"
                                   VerticalAlignment="Center" Margin="12,0"/>

                        <!-- Minute spinner -->
                        <StackPanel Width="64">
                            <Button Content="▲" Click="MinuteUp_Click"
                                    Style="{StaticResource OutlineButton}"
                                    Height="26" Padding="0" FontSize="10"
                                    Foreground="{StaticResource AccentBrush}"/>
                            <Border Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource AccentBrush}"
                                    BorderThickness="1" CornerRadius="6"
                                    Height="44" Margin="0,4">
                                <TextBlock x:Name="MinuteDisplay" Text="00"
                                           FontFamily="Consolas" FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Button Content="▼" Click="MinuteDown_Click"
                                    Style="{StaticResource OutlineButton}"
                                    Height="26" Padding="0" FontSize="10"
                                    Foreground="{StaticResource AccentBrush}"/>
                        </StackPanel>

                        <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                            <TextBlock Text="hours" FontFamily="Consolas" FontSize="9"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,0,0,36"/>
                            <TextBlock Text="minutes" FontFamily="Consolas" FontSize="9"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Date section — Once only -->
                <StackPanel x:Name="DateSection" Margin="0,16,0,0" Visibility="Collapsed">
                    <TextBlock Text="DATE" FontFamily="Consolas" FontSize="9"
                               FontWeight="SemiBold" Foreground="{StaticResource Muted2Brush}"
                               Margin="0,0,0,8"/>
                    <DatePicker x:Name="ScheduleDatePicker"
                                Height="40" Width="210" HorizontalAlignment="Left"
                                Background="{StaticResource SurfaceBrush}"
                                Foreground="{StaticResource TextBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                FontFamily="Consolas" FontSize="13"
                                SelectedDateChanged="DatePicker_SelectedDateChanged"/>
                </StackPanel>

                <!-- Days section — Weekdays only -->
                <StackPanel x:Name="DaysSection" Margin="0,20,0,0" Visibility="Collapsed">
                    <TextBlock Text="DAYS" FontFamily="Consolas" FontSize="9"
                               FontWeight="SemiBold" Foreground="{StaticResource Muted2Brush}"
                               Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="DayMon" Width="46" Height="46" CornerRadius="8"
                                Margin="0,0,6,0" Cursor="Hand" Tag="1"
                                MouseLeftButtonDown="Day_Click">
                            <TextBlock Text="Mon" FontFamily="Consolas" FontSize="9"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="DayTue" Width="46" Height="46" CornerRadius="8"
                                Margin="0,0,6,0" Cursor="Hand" Tag="2"
                                MouseLeftButtonDown="Day_Click">
                            <TextBlock Text="Tue" FontFamily="Consolas" FontSize="9"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="DayWed" Width="46" Height="46" CornerRadius="8"
                                Margin="0,0,6,0" Cursor="Hand" Tag="3"
                                MouseLeftButtonDown="Day_Click">
                            <TextBlock Text="Wed" FontFamily="Consolas" FontSize="9"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="DayThu" Width="46" Height="46" CornerRadius="8"
                                Margin="0,0,6,0" Cursor="Hand" Tag="4"
                                MouseLeftButtonDown="Day_Click">
                            <TextBlock Text="Thu" FontFamily="Consolas" FontSize="9"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="DayFri" Width="46" Height="46" CornerRadius="8"
                                Margin="0,0,6,0" Cursor="Hand" Tag="5"
                                MouseLeftButtonDown="Day_Click">
                            <TextBlock Text="Fri" FontFamily="Consolas" FontSize="9"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="DaySat" Width="46" Height="46" CornerRadius="8"
                                Margin="0,0,6,0" Cursor="Hand" Tag="6"
                                MouseLeftButtonDown="Day_Click">
                            <TextBlock Text="Sat" FontFamily="Consolas" FontSize="9"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="DaySun" Width="46" Height="46" CornerRadius="8"
                                Cursor="Hand" Tag="0"
                                MouseLeftButtonDown="Day_Click">
                            <TextBlock Text="Sun" FontFamily="Consolas" FontSize="9"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Divider -->
                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,20"/>

                <!-- Enable toggle -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Enable schedule"
                                   FontFamily="Consolas" FontSize="12"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Preset runs automatically at the configured time"
                                   FontFamily="Consolas" FontSize="9"
                                   Foreground="{StaticResource Muted2Brush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" x:Name="EnableToggle"
                            Width="48" Height="26" CornerRadius="13"
                            Cursor="Hand" MouseLeftButtonDown="EnableToggle_Click">
                        <Canvas>
                            <Ellipse x:Name="EnableThumb" Width="20" Height="20"
                                     Canvas.Top="3" Canvas.Left="4"/>
                        </Canvas>
                    </Border>
                </Grid>

                <!-- Next run preview -->
                <Border Margin="0,16,0,0"
                        Background="#0D00E5FF"
                        BorderBrush="#2200E5FF"
                        BorderThickness="1" CornerRadius="7" Padding="14,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Next run:  "
                                   FontFamily="Consolas" FontSize="11"
                                   Foreground="{StaticResource Muted2Brush}"/>
                        <TextBlock x:Name="NextRunLabel" Text="—"
                                   FontFamily="Consolas" FontSize="11"
                                   Foreground="{StaticResource AccentBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Action buttons -->
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Cancel"
                            Style="{StaticResource OutlineButton}"
                            Height="38" FontSize="12"
                            Click="Cancel_Click"/>
                    <Button Grid.Column="2" Content="💾  Save Schedule"
                            Style="{StaticResource PrimaryButton}"
                            Height="38" FontSize="12"
                            Click="Save_Click"/>
                </Grid>

            </StackPanel>
        </Grid>
    </Border>
</Window>
