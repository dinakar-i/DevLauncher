<Window x:Class="DevLauncher.Views.ScheduleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DevLauncher.Converters"
        xmlns:models="clr-namespace:DevLauncher.Models"
        xmlns:local="clr-namespace:DevLauncher.Views"
        Title="Schedule Preset"
        Width="500" SizeToContent="Height" MaxHeight="780"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{StaticResource BgBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome ResizeBorderThickness="0" CaptionHeight="40"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <Style TargetType="DatePickerTextBox">
            <Setter Property="Background"               Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground"               Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush"              Value="{StaticResource BorderBrush}"/>
            <Setter Property="CaretBrush"               Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontFamily"               Value="Consolas"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Calendar">
            <Setter Property="Background"      Value="{StaticResource Surface2Brush}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="CalendarDayButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize"   Value="11"/>
        </Style>
        <Style TargetType="CalendarButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0"
                    Background="{StaticResource Surface2Brush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12">
                        <Run Text="⏰  Schedules — " Foreground="{StaticResource Muted2Brush}"/>
                        <Run x:Name="TitlePresetName" Foreground="{StaticResource AccentBrush}"/>
                    </TextBlock>
                    <Border Grid.Column="1" Width="40" Height="40" Cursor="Hand"
                            MouseLeftButtonDown="CloseBtn_Click" Background="Transparent"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#CCEF4444"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="✕" FontSize="11" Foreground="{StaticResource Muted2Brush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,16,20,20">

                    <!-- Schedule list -->
                    <ItemsControl ItemsSource="{Binding Items, RelativeSource={RelativeSource AncestorType=Window}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ScheduleEditItem}">
                                <Border Margin="0,0,0,10"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="14,12">
                                    <StackPanel>

                                        <!-- Row 1: on/off  |  type pills  |  delete -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Enable toggle -->
                                            <Border Grid.Column="0" Width="44" Height="24" CornerRadius="12"
                                                    Cursor="Hand" Margin="0,0,10,0"
                                                    MouseLeftButtonDown="RowToggle_Click">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource MutedBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource Accent3Brush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Ellipse Width="18" Height="18" Fill="White" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Margin" Value="3,0,0,0"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                    <Setter Property="Margin" Value="0,0,3,0"/>
                                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                            </Border>

                                            <!-- Type pills -->
                                            <Border Grid.Column="1"
                                                    Background="{StaticResource Surface2Brush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="8" Padding="3">
                                                <WrapPanel>
                                                    <!-- None -->
                                                    <Border CornerRadius="6" Padding="9,5" Cursor="Hand">
                                                        <Border.InputBindings><MouseBinding Gesture="LeftClick" Command="{Binding SetTypeNoneCommand}"/></Border.InputBindings>
                                                        <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding Type}" Value="{x:Static models:ScheduleType.None}"><Setter Property="Background" Value="{StaticResource AccentGradient}"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                        <TextBlock Text="None" FontFamily="Consolas" FontSize="10" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted2Brush}"/><Style.Triggers><DataTrigger Binding="{Binding Type}" Value="{x:Static models:ScheduleType.None}"><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                                    </Border>
                                                    <!-- Startup -->
                                                    <Border CornerRadius="6" Padding="9,5" Cursor="Hand">
                                                        <Border.InputBindings><MouseBinding Gesture="LeftClick" Command="{Binding SetTypeStartupCommand}"/></Border.InputBindings>
                                                        <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding Type}" Value="{x:Static models:ScheduleType.OnStartup}"><Setter Property="Background" Value="{StaticResource AccentGradient}"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                        <TextBlock Text="⚡ Start" FontFamily="Consolas" FontSize="10" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted2Brush}"/><Style.Triggers><DataTrigger Binding="{Binding Type}" Value="{x:Static models:ScheduleType.OnStartup}"><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                                    </Border>
                                                    <!-- Once -->
                                                    <Border CornerRadius="6" Padding="9,5" Cursor="Hand">
                                                        <Border.InputBindings><MouseBinding Gesture="LeftClick" Command="{Binding SetTypeOnceCommand}"/></Border.InputBindings>
                                                        <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding Type}" Value="{x:Static models:ScheduleType.Once}"><Setter Property="Background" Value="{StaticResource AccentGradient}"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                        <TextBlock Text="Once" FontFamily="Consolas" FontSize="10" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted2Brush}"/><Style.Triggers><DataTrigger Binding="{Binding Type}" Value="{x:Static models:ScheduleType.Once}"><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                                    </Border>
                                                    <!-- Daily -->
                                                    <Border CornerRadius="6" Padding="9,5" Cursor="Hand">
                                                        <Border.InputBindings><MouseBinding Gesture="LeftClick" Command="{Binding SetTypeDailyCommand}"/></Border.InputBindings>
                                                        <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding Type}" Value="{x:Static models:ScheduleType.Daily}"><Setter Property="Background" Value="{StaticResource AccentGradient}"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                        <TextBlock Text="Daily" FontFamily="Consolas" FontSize="10" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted2Brush}"/><Style.Triggers><DataTrigger Binding="{Binding Type}" Value="{x:Static models:ScheduleType.Daily}"><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                                    </Border>
                                                    <!-- Weekdays -->
                                                    <Border CornerRadius="6" Padding="9,5" Cursor="Hand">
                                                        <Border.InputBindings><MouseBinding Gesture="LeftClick" Command="{Binding SetTypeWeekdaysCommand}"/></Border.InputBindings>
                                                        <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding Type}" Value="{x:Static models:ScheduleType.Weekdays}"><Setter Property="Background" Value="{StaticResource AccentGradient}"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                        <TextBlock Text="Weekdays" FontFamily="Consolas" FontSize="10" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted2Brush}"/><Style.Triggers><DataTrigger Binding="{Binding Type}" Value="{x:Static models:ScheduleType.Weekdays}"><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                                    </Border>
                                                </WrapPanel>
                                            </Border>

                                            <!-- Delete -->
                                            <Button Grid.Column="2" Content="✕"
                                                    Style="{StaticResource DangerButton}"
                                                    Padding="7,3" FontSize="9" Margin="10,0,0,0"
                                                    Command="{Binding DeleteItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>

                                        <!-- Time spinners -->
                                        <StackPanel Visibility="{Binding HasTime, Converter={StaticResource BoolVis}}"
                                                    Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="AT  " FontFamily="Consolas" FontSize="10"
                                                       Foreground="{StaticResource Muted2Brush}" VerticalAlignment="Center"/>
                                            <!-- Hour -->
                                            <StackPanel Width="52">
                                                <Button Content="▲" Command="{Binding HourUpCommand}" Style="{StaticResource OutlineButton}" Height="22" Padding="0" FontSize="9"/>
                                                <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="5" Height="36" Margin="0,3">
                                                    <TextBlock Text="{Binding HourText}" FontFamily="Consolas" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Button Content="▼" Command="{Binding HourDownCommand}" Style="{StaticResource OutlineButton}" Height="22" Padding="0" FontSize="9"/>
                                            </StackPanel>
                                            <TextBlock Text=":" FontFamily="Consolas" FontSize="20" FontWeight="Bold"
                                                       Foreground="{StaticResource Muted2Brush}" VerticalAlignment="Center" Margin="7,0"/>
                                            <!-- Minute -->
                                            <StackPanel Width="52">
                                                <Button Content="▲" Command="{Binding MinuteUpCommand}" Style="{StaticResource OutlineButton}" Height="22" Padding="0" FontSize="9"/>
                                                <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="5" Height="36" Margin="0,3">
                                                    <TextBlock Text="{Binding MinuteText}" FontFamily="Consolas" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Button Content="▼" Command="{Binding MinuteDownCommand}" Style="{StaticResource OutlineButton}" Height="22" Padding="0" FontSize="9"/>
                                            </StackPanel>
                                            <!-- AM/PM -->
                                            <StackPanel Width="44" Margin="8,0,0,0">
                                                <Button Content="▲" Command="{Binding ToggleAmPmCommand}" Style="{StaticResource OutlineButton}" Height="22" Padding="0" FontSize="9" Foreground="{StaticResource Accent3Brush}"/>
                                                <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource Accent3Brush}" BorderThickness="1" CornerRadius="5" Height="36" Margin="0,3">
                                                    <TextBlock Text="{Binding AmPmText}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Accent3Brush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Button Content="▼" Command="{Binding ToggleAmPmCommand}" Style="{StaticResource OutlineButton}" Height="22" Padding="0" FontSize="9" Foreground="{StaticResource Accent3Brush}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Date picker (Once) -->
                                        <StackPanel Visibility="{Binding HasDate, Converter={StaticResource BoolVis}}"
                                                    Margin="0,0,0,10">
                                            <TextBlock Text="DATE" FontFamily="Consolas" FontSize="9" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Muted2Brush}" Margin="0,0,0,6"/>
                                            <DatePicker SelectedDate="{Binding RunOnceDate, Mode=TwoWay}"
                                                        Height="36" Width="185" HorizontalAlignment="Left"
                                                        Background="{StaticResource SurfaceBrush}"
                                                        Foreground="{StaticResource TextBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        FontFamily="Consolas" FontSize="12"/>
                                        </StackPanel>

                                        <!-- Day toggles (Weekdays) -->
                                        <StackPanel Visibility="{Binding HasDays, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="DAYS" FontFamily="Consolas" FontSize="9" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Muted2Brush}" Margin="0,0,0,8"/>
                                            <StackPanel Orientation="Horizontal">
                                                <!-- Mon -->
                                                <Border Width="38" Height="38" CornerRadius="7" Margin="0,0,5,0" Cursor="Hand" BorderThickness="1">
                                                    <Border.InputBindings><MouseBinding Gesture="LeftClick" Command="{Binding ToggleMonCommand}"/></Border.InputBindings>
                                                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsMon}" Value="True"><Setter Property="Background" Value="{StaticResource AccentGradient}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                    <TextBlock Text="M" FontFamily="Consolas" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted2Brush}"/><Style.Triggers><DataTrigger Binding="{Binding IsMon}" Value="True"><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                                </Border>
                                                <!-- Tue -->
                                                <Border Width="38" Height="38" CornerRadius="7" Margin="0,0,5,0" Cursor="Hand" BorderThickness="1">
                                                    <Border.InputBindings><MouseBinding Gesture="LeftClick" Command="{Binding ToggleTueCommand}"/></Border.InputBindings>
                                                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsTue}" Value="True"><Setter Property="Background" Value="{StaticResource AccentGradient}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                    <TextBlock Text="T" FontFamily="Consolas" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted2Brush}"/><Style.Triggers><DataTrigger Binding="{Binding IsTue}" Value="True"><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                                </Border>
                                                <!-- Wed -->
                                                <Border Width="38" Height="38" CornerRadius="7" Margin="0,0,5,0" Cursor="Hand" BorderThickness="1">
                                                    <Border.InputBindings><MouseBinding Gesture="LeftClick" Command="{Binding ToggleWedCommand}"/></Border.InputBindings>
                                                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsWed}" Value="True"><Setter Property="Background" Value="{StaticResource AccentGradient}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                    <TextBlock Text="W" FontFamily="Consolas" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted2Brush}"/><Style.Triggers><DataTrigger Binding="{Binding IsWed}" Value="True"><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                                </Border>
                                                <!-- Thu -->
                                                <Border Width="38" Height="38" CornerRadius="7" Margin="0,0,5,0" Cursor="Hand" BorderThickness="1">
                                                    <Border.InputBindings><MouseBinding Gesture="LeftClick" Command="{Binding ToggleThuCommand}"/></Border.InputBindings>
                                                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsThu}" Value="True"><Setter Property="Background" Value="{StaticResource AccentGradient}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                    <TextBlock Text="T" FontFamily="Consolas" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted2Brush}"/><Style.Triggers><DataTrigger Binding="{Binding IsThu}" Value="True"><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                                </Border>
                                                <!-- Fri -->
                                                <Border Width="38" Height="38" CornerRadius="7" Margin="0,0,5,0" Cursor="Hand" BorderThickness="1">
                                                    <Border.InputBindings><MouseBinding Gesture="LeftClick" Command="{Binding ToggleFriCommand}"/></Border.InputBindings>
                                                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsFri}" Value="True"><Setter Property="Background" Value="{StaticResource AccentGradient}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                    <TextBlock Text="F" FontFamily="Consolas" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted2Brush}"/><Style.Triggers><DataTrigger Binding="{Binding IsFri}" Value="True"><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                                </Border>
                                                <!-- Sat -->
                                                <Border Width="38" Height="38" CornerRadius="7" Margin="0,0,5,0" Cursor="Hand" BorderThickness="1">
                                                    <Border.InputBindings><MouseBinding Gesture="LeftClick" Command="{Binding ToggleSatCommand}"/></Border.InputBindings>
                                                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsSat}" Value="True"><Setter Property="Background" Value="{StaticResource AccentGradient}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                    <TextBlock Text="S" FontFamily="Consolas" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted2Brush}"/><Style.Triggers><DataTrigger Binding="{Binding IsSat}" Value="True"><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                                </Border>
                                                <!-- Sun -->
                                                <Border Width="38" Height="38" CornerRadius="7" Cursor="Hand" BorderThickness="1">
                                                    <Border.InputBindings><MouseBinding Gesture="LeftClick" Command="{Binding ToggleSunCommand}"/></Border.InputBindings>
                                                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsSun}" Value="True"><Setter Property="Background" Value="{StaticResource AccentGradient}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                    <TextBlock Text="S" FontFamily="Consolas" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted2Brush}"/><Style.Triggers><DataTrigger Binding="{Binding IsSun}" Value="True"><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Add schedule button -->
                    <Button Content="＋  Add Schedule"
                            Style="{StaticResource OutlineButton}"
                            HorizontalAlignment="Left" Padding="16,8"
                            FontSize="11" Margin="0,0,0,16"
                            Click="AddSchedule_Click"/>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                    <!-- Save / Cancel -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel" Style="{StaticResource OutlineButton}"
                                Height="38" FontSize="12" Click="Cancel_Click"/>
                        <Button Grid.Column="2" Content="💾  Save Schedules" Style="{StaticResource PrimaryButton}"
                                Height="38" FontSize="12" Click="Save_Click"/>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
